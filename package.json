{
  "name": "goosley-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "opennextjs-cloudflare build",
    "build:next": "next build --webpack",
    "dev": "node server.mjs --dev",
    "start": "node server.mjs --production",
    "lint": "eslint",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "seed:portal": "tsx scripts/seed-portal.ts",
    "seed:d1:sql": "tsx scripts/write-portal-seed-sql.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && wrangler deploy --no-autoconfig",
    "upload": "opennextjs-cloudflare build && wrangler deploy --no-autoconfig",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "framer-motion": "^12.40.0",
    "lenis": "^1.3.23",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "wrangler": "^4.107.0"
  }
}
